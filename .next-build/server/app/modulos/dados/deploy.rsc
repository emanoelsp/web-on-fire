ck","margin":"0 20px 0 0","padding":"0 23px 0 0","fontSize":24,"fontWeight":500,"verticalAlign":"top","lineHeight":"49px"},"children":404}],["$","div",null,{"style":{"display":"inline-block"},"children":["$","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}]]}]}]}]]}],{"children":[["$","$1","c",{"children":[null,["$","$L4",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[null,["$","$L4",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[null,["$","$L4",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[["$","$L6",null,{"slides":[{"id":1,"type":"cover","tag":"Módulo 04 · Aula 05","title":"DEPLOY\n& ENTREGA","subtitle":"Do localhost para o mundo: publique o software e coloque no ar."},{"id":2,"type":"concept","tag":"Contexto","title":"\"Funciona na minha máquina\" não basta","items":[{"icon":"💻","text":"O projeto rodando em localhost:3000 só existe para você. Ninguém mais acessa."},{"icon":"🌍","text":"Deploy é o ato de publicar: colocar o app num servidor com uma URL pública, no ar 24/7."},{"icon":"🚀","text":"Vercel (criadora do Next.js) faz isso com integração perfeita: conecta ao GitHub e publica a cada push."},{"icon":"🎓","text":"É o 'culminar da entrega': o projeto vira um produto real, com link para colocar no portfólio e mostrar ao mundo."}]},{"id":3,"type":"diagram","tag":"O fluxo","title":"Do commit ao ar em minutos","subtitle":"CI/CD: integração e entrega contínuas, automáticas","layers":[{"icon":"💾","label":"git push","desc":"Você envia o código para o GitHub (Módulo 01!)","color":"neutral","connector":"a Vercel detecta o push"},{"icon":"🏗️","label":"BUILD AUTOMÁTICO","desc":"A Vercel roda npm run build na nuvem e checa erros","color":"amber","connector":"build passou?"},{"icon":"🌐","label":"DEPLOY","desc":"O app vai para uma CDN global — rápido no mundo todo","color":"green","connector":"URL pública gerada"},{"icon":"🔗","label":"NO AR","desc":"seu-projeto.vercel.app — acessível por qualquer pessoa","color":"fire"}],"loopBack":"cada novo push repete o ciclo automaticamente","tip":"CI/CD = você faz push, o resto é automático. Errou? A Vercel avisa no build e não publica a versão quebrada."},{"id":4,"type":"concept","tag":"Variáveis de ambiente","title":"O passo que todo iniciante esquece","items":[{"icon":"🔑","text":"Seu .env.local (chaves do Firebase) NÃO vai para o GitHub — está no .gitignore, e ainda bem."},{"icon":"⚙️","text":"Então na Vercel você recadastra as variáveis: Settings → Environment Variables."},{"icon":"🌐","text":"As NEXT_PUBLIC_ vão para o cliente; as demais (segredos) ficam só no servidor da Vercel."},{"icon":"💥","text":"Esqueceu de cadastrar? O build passa mas o app quebra em produção ('Firebase config undefined'). Erro nº 1."}]},{"id":5,"type":"code","tag":"Preparação","title":"O checklist antes de publicar","codeLabel":"terminal","code":"# 1. O build LOCAL passa sem erros? (a Vercel roda isto)\nnpm run build\n\n# 2. TypeScript limpo?\nnpx tsc --noEmit\n\n# 3. Tudo commitado e no GitHub?\ngit status          # deve estar limpo\ngit push\n\n# 4. .gitignore protege os segredos?\n#    .env.local  e  node_modules  DEVEM estar lá\n\n# 5. Firebase: domínio da Vercel autorizado?\n#    Auth → Settings → Authorized domains → adicione\n#    seu-projeto.vercel.app","tip":"Se o build quebra no seu PC, quebra na Vercel. Rodar npm run build localmente ANTES economiza deploys frustrados."},{"id":6,"type":"concept","tag":"Passo a passo","title":"Publicando na Vercel","items":[{"icon":"1️⃣","text":"Crie conta em vercel.com com seu GitHub (login social, 1 clique)."},{"icon":"2️⃣","text":"'Add New Project' → selecione o repositório. A Vercel detecta Next.js sozinha."},{"icon":"3️⃣","text":"Cadastre as Environment Variables (as mesmas do seu .env.local)."},{"icon":"4️⃣","text":"'Deploy'. Em ~1 minuto, sua URL pública está no ar. 🎉"}]},{"id":7,"type":"quiz","tag":"Quiz","title":"O erro clássico de deploy","question":"Seu app funciona local, o build passa na Vercel, mas em produção dá erro de Firebase 'API key undefined'. Causa mais provável?","options":[{"text":"O Firebase está fora do ar","correct":false,"explanation":"Improvável. Se fosse isso, falharia local também. O sintoma 'undefined' aponta para configuração."},{"text":"As variáveis de ambiente não foram cadastradas na Vercel","correct":true,"explanation":"Exato! O .env.local não vai para o Git. Sem recadastrar na Vercel, as chaves chegam como undefined em produção. Erro nº 1 de todo iniciante."},{"text":"Faltou rodar npm install","correct":false,"explanation":"A Vercel roda o install automaticamente. E isso quebraria o build, não o runtime."},{"text":"O código TypeScript tem um erro de tipo","correct":false,"explanation":"Erro de tipo quebraria o BUILD (que passou). Aqui o build passou e o app subiu — o problema é config em runtime."}],"xp":15},{"id":8,"type":"concept","tag":"Depois do deploy","title":"O app está no ar. E agora?","items":[{"icon":"🔍","text":"Teste em produção: login, cadastro, leitura e escrita no Firestore — o ambiente real pode revelar surpresas."},{"icon":"📊","text":"Vercel Analytics e Speed Insights: veja acessos reais e as notas de performance (Core Web Vitals do Módulo 02)."},{"icon":"🌿","text":"Preview deploys: cada branch/PR ganha uma URL própria para testar antes de ir para produção."},{"icon":"🏷️","text":"Domínio próprio: troque o .vercel.app por seu-dominio.com nas configurações quando quiser profissionalizar."}]},{"id":9,"type":"fill-blank","tag":"Mão na massa","title":"Complete o comando","instruction":"Antes de publicar, qual comando gera a versão de produção localmente — o mesmo que a Vercel executa? (digite o comando completo)","prefix":"$$ _______________\n\n  ▲ Next.js — Creating an optimized production build ...","answer":"npm run build","hint":"É o script 'build' definido no package.json.","xp":20},{"id":10,"type":"mini-challenge","tag":"🎯 Missão 18","title":"NO AR!","subtitle":"Coloque seu projeto no mundo real","tasks":["Garanta que npm run build passa sem erros localmente","Confirme que .env.local está no .gitignore e faça push do projeto para o GitHub","Crie conta na Vercel com o GitHub e importe o repositório","Cadastre todas as Environment Variables (as do seu .env.local)","Faça o deploy e acesse a URL pública gerada","Autorize o domínio .vercel.app no Firebase Auth e teste login + Firestore em produção"],"bonus":["Adicione o Vercel Analytics e veja os primeiros acessos","Coloque o link do projeto no ar no README do GitHub e no seu portfólio"],"xp":50,"nextHref":"/modulos/dados/desafio","nextLabel":"🏆 Desafio Final do Módulo →"}],"backHref":"/modulos/dados","backLabel":"Persistência & BaaS","aulaLabel":"Aula 05 — Deploy e Entrega","aulaSlug":"dados-deploy"}],["$L7"],"$L8"]}],{},null,false,null]},null,false,"$@9"]},null,false,"$@9"]},null,false,"$@9"]},null,false,null],"$La",false]],"m":"$undefined","G":["$b",["$Lc"]],"S":true,"h":null,"s":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"g-pGVvcGEV9O4jPvRGyfJ"}
