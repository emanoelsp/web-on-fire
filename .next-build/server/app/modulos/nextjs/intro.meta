{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/modulos/layout,_N_T_/modulos/nextjs/layout,_N_T_/modulos/nextjs/intro/layout,_N_T_/modulos/nextjs/intro/page,_N_T_/modulos/nextjs/intro"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/modulos/nextjs/intro/__PAGE__",
    "/modulos/nextjs/intro",
    "/modulos/nextjs",
    "/modulos",
    "/_index",
    "/_head"
  ]
}